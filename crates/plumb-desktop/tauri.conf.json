{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plumb Search",
  "identifier": "io.github.sueheir.plumbsearch",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Plumb Search",
    "copyright": "Copyright (c) 2026 Elizabeth Suehr",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/SueHeir/plumb-search",
    "category": "Utility",
    "shortDescription": "A search engine that runs on your computer",
    "longDescription": "Plumb Search is a free, open-source search engine. It builds its own index of site names from public seed data and its own homepage crawls, and searches it on your computer.",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
